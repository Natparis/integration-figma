{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmit": true,
    "lib": ["ES2020"],
    "typeRoots": ["../../node_modules/@figma", "../../node_modules/@types"],
    "types": ["plugin-typings"]
  },
  "include": ["src/**/*.ts"]
}
